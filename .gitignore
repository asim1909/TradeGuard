# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Pytest / Coverage / Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/
venv.bak/
build/
dist/
*.egg-info/

# Data & Output Files (Excludes large CSVs, preserving directory structure via .gitkeep)
data/raw/*.csv
data/processed/*.csv
data/sample_output/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/sample_output/.gitkeep

# SQLite Database Files
*.db
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite
!database/.gitkeep

# Generated Reports & Datasets
reports/excel/*.xlsx
reports/csv/*.csv
reports/json/*.json
reports/charts/*.png
reports/powerbi/*.csv
!reports/excel/.gitkeep
!reports/csv/.gitkeep
!reports/json/.gitkeep
!reports/charts/.gitkeep
!reports/powerbi/.gitkeep

# Application Logs
logs/*.log
logs/*
!logs/.gitkeep

# IDE & Operating System Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
